# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Painel Supabase: Project Settings > API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Integração de servidor com a API de balança.
# Nunca prefixe estas variáveis com VITE_ e nunca as use em código do navegador.
AGRO_API_BASE_URL=https://api-agro.agrvilanova.online
AGRO_API_CLIENT_ID=cliente-exclusivo-deste-projeto
AGRO_API_CLIENT_SECRET=segredo-hmac-base64url
AGRO_CF_ACCESS_CLIENT_ID=id-do-service-token-cloudflare
AGRO_CF_ACCESS_CLIENT_SECRET=segredo-do-service-token-cloudflare

# Opcional
VITE_ENABLE_DEVELOPMENT_PAGE=false
